{
  "name": "noel-et-merveilles",
  "version": "1.0.0",
  "description": "Boutique de Noël virtuelle en 3D — vitrine d’affiliation Amazon pour le challenge Pinterest.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "conformite": "esbuild scripts/conformite.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp-conformite.cjs --log-level=error && node node_modules/.tmp-conformite.cjs",
    "ancres": "esbuild scripts/ancres.ts --bundle --platform=node --format=cjs --outfile=node_modules/.tmp-ancres.cjs --log-level=error && node node_modules/.tmp-ancres.cjs",
    "rendu": "esbuild scripts/rendu.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.tmp-rendu.cjs --log-level=error --external:react --external:react-dom --external:jsdom && node node_modules/.tmp-rendu.cjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "postprocessing": "^6.39.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "type": "module"
}